---
previewLayout: design-example-wrapper-full
---

{% extends "layouts/design-example-wrapper.njk" %}

{% from "back-link/macro.njk" import backLink %}
{% from "button/macro.njk" import button %}
{% from "radios/macro.njk" import radios %}

{% set mainClasses = "nhsuk-main-wrapper nhsuk-main-wrapper--xl" %}

{% set heroContentHtml %}
  <p class="nhsuk-body-l">A short tagline to add a bit more detail.</p>
  <div class="nhsuk-button-group nhsuk-u-margin-bottom-0">
    {{ button({
      text: "Create an account",
      href: "#",
      classes: "nhsuk-button--reverse"
    }) }}

    <a href="#" class="nhsuk-link nhsuk-link--reverse">Log in</a>
  </div>
{% endset %}

{% block main %}
  {{ hero({
    border: true,
    content: [
      {
        heading: {
          text: "Headline to describe the service",
          size: "l",
          caption: false
        },
        html: heroContentHtml
      },
      {
        image: {
          src: "/assets/example-hero-image.svg",
          width: "three-quarters",
          background: false,
          border: false
        }
      }
    ],
    image: false
  }) }}

  <div class="nhsuk-main-wrapper">
    
    <div class="nhsuk-width-container">
      <div class="nhsuk-grid-row nhsuk-u-padding-bottom-4">
        <div class="nhsuk-grid-column-one-third">
          <h2 class="nhsuk-heading-s nhsuk-u-margin-bottom-2">1st benefit</h2>
          <p>Description of how the service solves a problem.</p>
        </div>
        <div class="nhsuk-grid-column-one-third">
          <h2 class="nhsuk-heading-s nhsuk-u-margin-bottom-2">2nd benefit</h2>
          <p>Another reason to use the service.</p>
        </div>
        <div class="nhsuk-grid-column-one-third">
          <h2 class="nhsuk-heading-s nhsuk-u-margin-bottom-2">3rd benefit</h2>
          <p>Something else about the service.</p>
        </div>
      </div>
    </div>

      <div class="nhsuk-u-padding-top-7 nhsuk-u-padding-bottom-4" style="background-color: #ffffff;">
        <div class="nhsuk-width-container">

          <h2 class="nhsuk-heading-m">How it works</h2>

          <div class="nhsuk-grid-row">
            <div class="nhsuk-grid-column-two-thirds">
              <h2 class="nhsuk-heading-s nhsuk-u-margin-bottom-2">1. Do this first</h2>
              <p>Description of the first step to get started using this service.</p>
            </div>
            <div class="nhsuk-grid-column-one-third">
              {{ image({
                src: "/assets/image-example.svg",
                alt: "Placeholder image",
                width: "full",
                background: false,
                border: false
              }) }}
            </div>
          </div>

          <div class="nhsuk-grid-row">
            <div class="nhsuk-grid-column-two-thirds">
              <h2 class="nhsuk-heading-s nhsuk-u-margin-bottom-2">2. Do this next</h2>
              <p>Description of the second step to get started using this service.</p>
            </div>
            <div class="nhsuk-grid-column-one-third">
              {{ image({
                src: "/assets/image-example.svg",
                alt: "Placeholder image",
                width: "full",
                background: false,
                border: false
              }) }}
            </div>
          </div>

        </div>
      </div>

    <div class="nhsuk-width-container">

      <h2 class="nhsuk-heading-m nhsuk-u-padding-top-7">Who uses this service</h2>

      <ul class="nhsuk-grid-row nhsuk-card-group">
        <li class="nhsuk-grid-column-one-third nhsuk-card-group__item">
          {{ card({
            heading: {
              text: "64",
              size: "m",
              visuallyHiddenText: "Trusts",
              classes: "nhsuk-u-margin-bottom-1"
            },
            description: {
              text: "Trusts"
            }
          }) }}
        </li>
        <li class="nhsuk-grid-column-one-third nhsuk-card-group__item">
          {{ card({
            heading: {
              text: "46,000",
              size: "m",
              visuallyHiddenText: "Daily users",
              classes: "nhsuk-u-margin-bottom-1"
            },
            description: {
              text: "Daily users"
            }
          }) }}
        </li>
        <li class="nhsuk-grid-column-one-third nhsuk-card-group__item">
          {{ card({
            heading: {
              text: "4 million",
              size: "m",
              visuallyHiddenText: "Bookings",
              classes: "nhsuk-u-margin-bottom-1"
            },
            description: {
              text: "Bookings"
            }
          }) }}
        </li>
      </ul>
    </div>

  </div>

{% endblock %}
