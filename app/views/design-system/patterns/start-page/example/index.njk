---
previewLayout: design-example-wrapper-full
---

{% extends "layouts/design-example-wrapper-full-layout.njk" %}

{% from "breadcrumb/macro.njk" import breadcrumb %}
{% from "button/macro.njk" import button %}
{% from "inset-text/macro.njk" import insetText %}

{% set mainClasses = "nhsuk-main-wrapper--s" %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        href: "#",
        text: "Home"
      },
      {
        href: "#",
        text: "NHS services"
      }
    ]
  }) }}
{% endblock %}

{% block content %}
  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-two-thirds">

      <h1 class="nhsuk-heading-xl">Find alcohol addiction support services</h1>
      <p>Alcohol addiction services can help you reduce or stop your drinking if it's affecting your life or your health.</p>
      <p>Alcohol addiction services include:</p>
      <ul>
        <li>support to help you stop drinking</li>
        <li>rehabilitation</li>
        <li>counselling and cognitive behavioural therapy (CBT)</li>
        <li>group therapy</li>
        <li>self-help</li>
      </ul>
      <h2 class="nhsuk-heading-l">Before you start</h2>
      <p>We'll ask you where you live in England. This is so we can find the right services for you.</p>      
 
      <p>By using this service you agree to our <a href="#">terms of use</a> and confirm that you have read the <a href="#">privacy policy</a>.</p>

      {{ button({
        text: "Start now",
        href: "#"
      }) }}

      <p>If you do not live in England visit <a href="#">NHS Inform for Scotland</a>, <a href="#">NHS 111 for Wales</a> or <a href="#">Health and Social Care online for Northern Ireland</a>.</p>

    </div>
  </div>
{% endblock %}
