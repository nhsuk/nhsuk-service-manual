{% from "date-input/macro.njk" import dateInput %}

{{ dateInput({
  fieldset: {
    legend: {
      heading: "What is your date of birth?",
      size: "l"
    }
  },
  hint: {
    text: "For example, 15 3 1984"
  },
  id: "date-of-birth",
  namePrefix: "dateOfBirth",
  day: {
    width: 2,
    autocomplete: "bday-day"
  },
  month: {
    width: 2,
    autocomplete: "bday-month"
  },
  year: {
    width: 4,
    autocomplete: "bday-year"
  }
}) }}
