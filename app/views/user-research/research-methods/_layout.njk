{% extends "layouts/layout.njk" %}

{% block beforeContent %}
  {{ breadcrumb({
    items: [
      {
        href: "/",
        text: "Home"
      },
      {
        href: "/user-research",
        text: "User research"
      },
      {
        href: "/user-research/research-methods",
        text: "Research methods"
      }
    ]
  }) }}
{% endblock %}

{% block content %}

  <div class="nhsuk-grid-row">
    <div class="nhsuk-grid-column-full app-component-reading-width">

      <h1>
        {%- if pageSection %}
        <span class="nhsuk-caption-l">
          {{pageSection}}
          <span class="nhsuk-u-visually-hidden"> – </span>
        </span>
        {% else %}
        {% endif %}
        {{pageTitle}}
      </h1>

      <p class="nhsuk-body-l">{{pageDescription}}</p>

      {% block bodyContent %}
      {% endblock %}

    </div>
  </div>

{% endblock %}
