{% extends "layouts/app-layout.njk" %}

{% set pageTitle = "Coming soon" %}
{% set pageSection = "Community and contribution" %}
{% set pageDescription = "Work in progress and what's up next on the service manual and design system." %}
{% set dateUpdated = "August 2026" %}

{% block beforeContent %}
  {% include "community-and-contribution/_breadcrumb.njk" %}
{% endblock %}

{% block bodyContent %}
  <p>For more detail, see the relevant GitHub issue in the community backlog.</p>
  <h2 class="nhsuk-heading-l">In progress</h2>

  {{ summaryList({
    rows: [
      {
        key: { 
          text: "Common error pages" 
        },
        value: { 
          html: "Page not found (<a href=\"https://github.com/nhsuk/nhsuk-service-manual-community-backlog/issues/233\">GitHub backlog issue #233</a>), Service unavailable (<a href=\"https://github.com/nhsuk/nhsuk-service-manual-community-backlog/issues/588\">issue #588<span class=\"nhsuk-u-visually-hidden\"> in GitHub</span></a>) and There is a problem with the service (<a href=\"https://github.com/nhsuk/nhsuk-service-manual-community-backlog/issues/413\">issue #413<span class=\"nhsuk-u-visually-hidden\"> in GitHub</span></a>)"
        }
      },
      {
        key: { 
          text: "Section navigation" 
        },
        value: { 
          html: "A list of links to allow users to navigate between pages in a section of a service (<a href=\"https://github.com/nhsuk/nhsuk-service-manual-community-backlog/issues/556\">issue #556<span class=\"nhsuk-u-visually-hidden\"> in GitHub</span></a>)"
        }
      },
      {
        key: { 
          text: "Showing updates" 
        },
        value: { 
          text: "Ways to show what we've updated on service standard and design system pages" 
        }
      }
    ]
  }) }}

  <h2 class="nhsuk-heading-l">Next</h2>
  {{ summaryList({
    rows: [
      {
        key: { 
          text: "NHS.UK frontend v11" 
        },
        value: { 
          text: "Breaking release featuring new link styling, and updated grid and code improvements" 
        }
      },
      {
        key: { 
